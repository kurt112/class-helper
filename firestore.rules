rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // A teacher's classes: classes they own, plus classes/{uid} (their class from before multiple classes).
    function owns(cls) {
      return signedIn() && (cls == request.auth.uid || get(/databases/$(database)/documents/classes/$(cls)).data.owner == request.auth.uid);
    }
    match /classes/{cls} {
      allow read, delete: if signedIn() && (cls == request.auth.uid || resource.data.owner == request.auth.uid);
      // ...and a class can't be handed to someone else: after any change the owner is still this teacher.
      allow update: if signedIn() && (cls == request.auth.uid || resource.data.owner == request.auth.uid)
        && request.resource.data.get('owner', request.auth.uid) == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
    }
    match /classes/{cls}/learners/{learner} {
      allow read, write: if owns(cls);
    }
    // Pro licenses, keyed by the teacher's lowercase Google email. Only the admin (verified Google account)
    // can create, change or remove one; teachers can only read their own. The admin never gets class data.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'designscribe.solution@gmail.com' && request.auth.token.email_verified == true;
    }
    match /licenses/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email.lower() == email);
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['until', 'amount', 'note', 'activatedAt'])
        && request.resource.data.until is string && request.resource.data.until.matches('^\\d{4}-\\d{2}-\\d{2}$');
      allow delete: if isAdmin();
    }
  }
}
